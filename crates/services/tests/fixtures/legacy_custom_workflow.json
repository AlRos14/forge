  "configuration": [
    {
      "id": "verification_retries",
      "label": "Verification retries",
      "description": "Rejected verification cycles allowed before escalation.",
      "value_type": "integer",
      "min": 0,
      "default_value": 3,
      "binding": {
        "type": "gate_config",
        "state": "verification",
        "field": "max_rejections"
      }
    },
    {
      "id": "implementer_notes",
      "label": "Implementer notes",
      "description": "Extra guidance shown to the implementer.",
      "value_type": "text",
      "min": null,
      "default_value": "",
      "binding": {
        "type": "state_config",
        "state": "building",
        "path": ["prompt", "user_append"]
      }
    }
  ],
  "cancellation_state": "abandoned"
}
