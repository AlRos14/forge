      "cleanup": null,
      "gate_config": {
        "reject_target": "building",
        "max_rejections": 3,
        "approve_label": "Verify",
        "reject_label": "Send back",
        "requires_user_approval": true,
        "optional_when_unassigned": false
      },
      "dispatch": null,
      "triggers": {
        "accept": { "to": "shipping", "dispatch": null },
        "reject": {
          "to": "building",
          "dispatch": {
            "builder": "coder.review_fix.v2",
            "execution_policy": "resume_latest_target_role_thread",
            "prompt": {
              "user_prefix": null,
              "user_append": "Address verification feedback before returning.",
              "system_prefix": null,
              "system_append": null
            }
          }
        }
      },
      "config": {}
    },
